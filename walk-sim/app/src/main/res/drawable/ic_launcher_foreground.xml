<?xml version="1.0" encoding="utf-8"?>
<!-- Original "Sprout Pin" launcher foreground: a white map-pin whose head holds a garden sprout.
     Hand-authored; NOT derived from any Nintendo/Niantic/Pikmin artwork. 108x108 adaptive canvas —
     all art is kept inside the ~66dp safe circle (centre 54,54 radius 33) so no mask crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White teardrop pin body: head circle (semicircle top) tapering to a point at the bottom. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,84
                          C41,65 34,57 34,43
                          A20,20 0 1,1 74,43
                          C74,57 67,65 54,84 Z" />

    <!-- Soft-pink window in the head (Surface token) so the green sprout reads against the white pin. -->
    <path
        android:fillColor="#FFFFF5F8"
        android:pathData="M40,41 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />

    <!-- Garden-green sprout: tapered stem + two leaves, seated in the head window. -->
    <path
        android:fillColor="#FF43A047"
        android:pathData="M52.5,52 C52.5,46 52.5,40 54,31 C55.5,40 55.5,46 55.5,52 Z" />
    <path
        android:fillColor="#FF43A047"
        android:pathData="M53,46 C46,46 43,42 43,35 C48,36 52,40 53,46 Z" />
    <path
        android:fillColor="#FF43A047"
        android:pathData="M55,46 C62,46 65,42 65,35 C60,36 56,40 55,46 Z" />
</vector>
